# Copy to .env.local for local work, and set the same names in the host's environment (Vercel: Project Settings > Environment Variables).
# Never commit real values.

# Public URL of the site (used for canonical links, sitemap and the API's same-origin check). Example: https://eclub.nitw.ac.in
NEXT_PUBLIC_SITE_URL=

# Contact and join form storage (Cloud Firestore, service account). Leave all three empty and the forms fall back to the visitor's email app.
# See docs/BACKEND.md for the one-time setup.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private_key value from the service-account JSON, kept on one line with \n escapes.
FIREBASE_PRIVATE_KEY=

# Secret for the daily retention job (/api/cron/purge). Any random string of 16+ characters, for example: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
